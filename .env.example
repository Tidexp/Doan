# PostgreSQL (bắt buộc có extension pgvector)
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/knowledge_os

# Neo4j AuraDB
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Gemini
GEMINI_API_KEY=
GEMINI_EXTRACT_MODEL=gemini-2.0-flash-lite
GEMINI_ANSWER_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Auth.js
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000
# Google sign-in. Users must already exist (admin creates them with Google login).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional: restrict Google sign-in to a domain, e.g. company.com
AUTH_GOOGLE_ALLOWED_DOMAIN=
# Google Drive Picker (enable Google Drive API and Google Picker API in Cloud Console)
NEXT_PUBLIC_GOOGLE_DRIVE_API_KEY=
# Google Cloud project number (not the OAuth client ID)
NEXT_PUBLIC_GOOGLE_DRIVE_APP_ID=

# Guest demo account (tùy chọn, seed sẽ tạo nếu thiếu)
GUEST_EMAIL=guest@local
GUEST_NAME=Khách

# Pipeline
EMBED_CONCURRENCY=6
EXTRACT_CONCURRENCY=6
CHUNK_MAX_CHARS=3500
UPLOAD_DIR=./uploads
