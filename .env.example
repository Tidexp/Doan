# PostgreSQL (bắt buộc có extension pgvector)
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/knowledge_os

# Neo4j AuraDB
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Gemini
GEMINI_API_KEY=
GEMINI_EXTRACT_MODEL=gemini-2.0-flash-lite
GEMINI_ANSWER_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Auth.js
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Guest demo account (tùy chọn, seed sẽ tạo nếu thiếu)
GUEST_EMAIL=guest@local
GUEST_NAME=Khách

# Pipeline
EMBED_CONCURRENCY=6
EXTRACT_CONCURRENCY=6
CHUNK_MAX_CHARS=3500
UPLOAD_DIR=./uploads
